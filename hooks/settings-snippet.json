{
  "hooks": {
    "SessionStart":     [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/session-state.sh waiting", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [
      { "type": "command", "command": "$HOME/.claude/hooks/session-state.sh working", "timeout": 5 },
      { "type": "command", "command": "/usr/bin/python3 -I $HOME/.claude/island/taskqueue.py prompt", "timeout": 5 } ] }],
    "PreToolUse":       [{ "matcher": "*", "hooks": [{ "type": "command", "command": "bash $HOME/.claude/hooks/activity.sh", "timeout": 3 }] }],
    "Notification":     [{ "hooks": [
      { "type": "command", "command": "$HOME/.claude/hooks/session-state.sh waiting", "timeout": 5 },
      { "type": "command", "command": "$HOME/.claude/hooks/notify.sh input", "timeout": 5 } ] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 -I $HOME/.claude/hooks/stop.py", "timeout": 15 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/session-state.sh end", "timeout": 5 }] }]
  }
}
